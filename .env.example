# CryptoGuard AI — Environment Configuration
# Copy to .env and fill in values

# === Cloud Mode (Nebius AI) ===
# Set this to enable Nemotron Ultra/Nano via Nebius Token Factory
CG_NEBIUS_API_KEY=

# NIM API endpoint (default: Nebius studio)
CG_NIM_BASE_URL=https://api.studio.nebius.com/v1/

# Model identifiers
CG_MODEL_ULTRA=nvidia/llama-3.1-nemotron-ultra-253b-v1
CG_MODEL_NANO=nvidia/llama-3.1-nemotron-nano-8b-v1

# NeVA multimodal endpoint (optional)
CG_NEVA_ENDPOINT=

# === Pipeline Mode (Redis) ===
# Set this to enable the entropy pipeline (ingestion → extraction → conditioning → anchoring)
CG_REDIS_URL=redis://localhost:6379

# === RL Feedback ===
CG_RL_FEEDBACK_ENABLED=false

# === Rate Limiting ===
CG_RATE_LIMIT_RPM=60

# === Logging ===
CG_LOG_LEVEL=INFO
